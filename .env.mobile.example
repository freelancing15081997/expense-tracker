# Mobile App Environment Variables
# Copy this to .env for development

# Firebase Configuration (already in code, but can be overridden)
VITE_FIREBASE_API_KEY=AIzaSyDQUXdMTTUOONPbua5cWm75Jn-7-SkRwjE
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0616065043.firebaseapp.com
