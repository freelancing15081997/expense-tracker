# API Endpoints (if different for mobile)
VITE_API_URL=https://www.easypado.com
VITE_API_TIMEOUT=30000

# Mobile-specific settings
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_GEOLOCATION=true
