# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/byjan
DB_READ_URL=postgresql+asyncpg://user:pass@localhost:5432/byjan_read

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (HS256 — JWT_SECRET_KEY is enough; optional key aliases below)
JWT_SECRET_KEY=change-me-in-production
JWT_PRIVATE_KEYS=
JWT_PUBLIC_KEYS=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/key.json
# Or paste the full service-account JSON string (preferred on Render):
FIREBASE_SERVICE_ACCOUNT_JSON=

# App
SECRET_KEY=change-me
APP_ENV=development
SECURE_COOKIES=false

# Storage (Cloudflare R2 / S3)
S3_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=byjan-files
S3_REGION=auto

# Email (Resend)
EMAIL_API_KEY=re_api_key
EMAIL_FROM=noreply@easypado.com

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_BUSINESS_ACCOUNT_ID=your-ba-id

# GSP (GST Filing)
GSP_API_KEY=your-gsp-key
GSP_API_URL=https://gsp-provider.com/api

# Sentry
SENTRY_DSN=https://your-sentry-dsn

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# CORS
CORS_ORIGINS=https://business.easypado.com,https://api.easypado.com

# Console IP Allowlist
CONSOLE_IP_ALLOWLIST=1.2.3.4,5.6.7.8

# Environment
ENVIRONMENT=local
DEBUG=true
