# API Configuration
VITE_API_URL=http://localhost:8000
VITE_APP_URL=http://localhost:5173
VITE_ENV=development

# Auth: mock = local demo sign-in (no backend), live = Firebase + /v1/auth/*
# Production Cloudflare Pages must use live + DEMO_SEED=0
VITE_AUTH_MODE=mock
# Minutes without activity before sign-out (server role setting overrides when present)
VITE_IDLE_MINUTES=30

# Demo data: 1 = pre-seed the Sharma Traders sample workspace (design review only).
# Unset/0 = clean workspace — a new user sees no demo parties, docs or metrics.
VITE_DEMO_SEED=0

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Feature Flags
VITE_FEATURE_EINVOICE=false
VITE_FEATURE_EWAYBILL=false
VITE_FEATURE_GST_FILING=false
VITE_FEATURE_BANK_FEED=false
VITE_FEATURE_WHATSAPP=false

# Analytics
VITE_ANALYTICS_ID=

# Sentry (optional)
VITE_SENTRY_DSN=
