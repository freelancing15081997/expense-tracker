# Environment Variables

# ==============================================
# EMAIL NOTIFICATIONS (SMTP Configuration)
# ==============================================

# Required for email notifications to work
# Without these, email sending will fail with authentication errors

# SMTP Server (Gmail example - you can use any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail Account Credentials
# IMPORTANT: For Gmail, you MUST use an App Password, not your regular password
# See setup instructions below
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# ========== How to Get Gmail App Password ==========
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Name it "Byjan Expense Tracker"
# 6. Click "Generate"
# 7. Copy the 16-character password (remove spaces)
# 8. Paste it as SMTP_PASS above
#
# Alternative: Use any other SMTP service:
# - SendGrid: smtp.sendgrid.net (port 587)
# - Mailgun: smtp.mailgun.org (port 587)
# - AWS SES: email-smtp.region.amazonaws.com (port 587)
# - Resend: smtp.resend.com (port 587)
# ====================================================

# ==============================================
# REQUIRED FOR PRODUCTION
# ==============================================

# Neon Postgres Database (REQUIRED)
# Get from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname
POSTGRES_URL=postgresql://user:password@host.neon.tech/dbname

# Optional: Use non-pooled connection for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/dbname
POSTGRES_URL_NON_POOLING=postgresql://user:password@host.neon.tech/dbname

# ==============================================
# OPTIONAL: FILE STORAGE
# ==============================================

# Vercel Blob — for receipts, attachments, logos, and document uploads
# Get from: https://vercel.com/dashboard → Storage → Blob → Create Store
# IMPORTANT: Required for logo uploads and file attachments
# Without this, users will see "File upload is not configured" errors
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ==============================================
# OPTIONAL: NEON AUTH (Future Authentication)
# ==============================================

# Neon Auth (for future migration from Firebase Auth)
# Get from: https://console.neon.tech → Authentication
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=

# ==============================================
# ONE-TIME MIGRATION CREDENTIALS
# ==============================================
# Only needed for the initial Firestore → Postgres migration
# After migration completes, these can be removed
# DO NOT commit these to git - use a local .env file

# Firebase Project Info (don't change these)
FIREBASE_PROJECT_ID=gen-lang-client-0616065043
FIREBASE_DATABASE_ID=ai-studio-sharedsheetexpen-15aa5fbb-9604-4c59-b4a3-aa994442cb50

# Firebase Admin Credentials - Choose ONE method below:

# Method 1: Service Account JSON (Recommended)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON as a single line string
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Method 2: Path to Service Account JSON file
# Download the file and provide its absolute path
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Method 3: Individual Credentials
# Extract from service account JSON
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==============================================
# MIGRATION NOTES
# ==============================================
#
# To migrate from Firebase to Neon:
# 1. Fill in DATABASE_URL (required)
# 2. Fill in ONE Firebase credential method (required for migration)
# 3. Run: npm install firebase-admin --no-save
# 4. Run: npm run migrate:firestore
# 5. Run: npm run validate:migration
# 6. Deploy with DATABASE_URL set
# 7. After successful migration, remove Firebase credentials
#
# See SETUP.md for quick start guide
# See MIGRATION_GUIDE.md for detailed instructions
#
