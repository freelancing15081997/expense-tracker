# Vercel Blob — file bytes only (receipts, logos, attachments)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Neon / Vercel Postgres — all records (not Firebase, not Blob JSON)
DATABASE_URL=
POSTGRES_URL=
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=

# Neon Auth (Managed Better Auth). Client needs VITE_ prefix.
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=

# One-time Firestore → Postgres migration (npm run migrate:firestore)
# Do not put real keys here. Use a local gitignored .env.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
