{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "ignoreCommand": "node -e \"process.exit((process.env.VERCEL_PROJECT_NAME||'')==='android'?0:1)\"",
  "functions": {
    "api/kv.ts": { "maxDuration": 30, "includeFiles": "api/_pg-tables.js" },
    "api/invites.ts": { "maxDuration": 15, "includeFiles": "api/_pg-tables.js" },
    "api/tracker.ts": { "maxDuration": 30, "includeFiles": "api/{_pg-tables.js,_lib/**}" },
    "api/migrate.ts": { "maxDuration": 60, "includeFiles": "api/_pg-tables.js" },
    "api/email/send.ts": { "maxDuration": 60 },
    "api/auth/otp.ts": { "maxDuration": 30, "includeFiles": "api/{_pg-tables.js,_lib/**}" },
    "api/email/inbound.ts": { "maxDuration": 60, "includeFiles": "api/{_pg-tables.js,_lib/**}" },
    "api/blob/upload.ts": { "maxDuration": 30, "includeFiles": "api/{_pg-tables.js,_lib/**}" },
    "api/blob/delete.ts": { "maxDuration": 15, "includeFiles": "api/{_pg-tables.js,_lib/**}" },
    "api/blob/file.ts": { "maxDuration": 15, "includeFiles": "api/_lib/**" }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type,X-CSRF-Token,X-Requested-With,Accept,X-Tenant-Id,X-Book-Id,X-File-Id,X-File-Ext,X-File-Name,X-Content-Type,X-Inbound-Secret,X-Brevo-Secret,X-Hint-Text,vercel-blob-api-version" },
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Vary", "value": "Origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/email/send-report", "destination": "/api/email/send" },
    { "source": "/api/email/unsubscribe", "destination": "/api/email/send?op=unsubscribe" },
    { "source": "/api/ledgers", "destination": "/api/tracker?domain=ledgers" },
    { "source": "/api/expenses", "destination": "/api/tracker?domain=expenses" },
    { "source": "/api/notifications", "destination": "/api/tracker?domain=notifications" },
    { "source": "/api/me", "destination": "/api/tracker?domain=me" },
    { "source": "/api/support", "destination": "/api/tracker?domain=support" },
    { "source": "/api/money", "destination": "/api/tracker?domain=money" },
    { "source": "/api/books", "destination": "/api/tracker?domain=books" },
    { "source": "/api/auth/:path*", "destination": "/api" },
    { "source": "/neondb/auth/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
