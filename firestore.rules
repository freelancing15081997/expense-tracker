rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }

    match /books/{bookId} {
      function isMember() {
        return isAuthenticated() && 
               resource.data.roles[request.auth.uid].role in ['owner', 'admin', 'contributor', 'viewer', 'auditor'];
      }
      
      function getRole() {
        return isMember() ? resource.data.roles[request.auth.uid].role : 'none';
      }
      
      allow read: if isMember();
      
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && request.resource.data.roles[request.auth.uid].role == 'owner';
      
      allow update: if (isMember() && (getRole() in ['owner', 'admin'])) 
                    || (isMember() && !(request.auth.uid in request.resource.data.roles))
                    || (
                      !isMember() 
                      && ('email' in request.auth.token)
                      && exists(/databases/$(database)/documents/invites/$(bookId + '_' + request.auth.token.email))
                    );
      
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      
      match /expenses/{expenseId} {
        function isBookMember() {
          return get(/databases/$(database)/documents/books/$(bookId)).data.roles[request.auth.uid].role in ['owner', 'admin', 'contributor', 'viewer', 'auditor'];
        }
        function getBookRole() {
          return isBookMember() ? get(/databases/$(database)/documents/books/$(bookId)).data.roles[request.auth.uid].role : 'none';
        }
        
        allow read: if isAuthenticated() && isBookMember();
        allow create, update, delete: if isAuthenticated() && isBookMember() && (getBookRole() in ['owner', 'admin', 'contributor', 'auditor']);
      }
    }

    match /invites/{inviteId} {
      function getEmail() {
        return ('email' in request.auth.token) ? request.auth.token.email : '';
      }
      
      allow read: if isAuthenticated() && (getEmail() == resource.data.email || request.auth.uid == resource.data.invitedBy);
      allow create: if isAuthenticated() && request.resource.data.invitedBy == request.auth.uid;
      allow update: if isAuthenticated() && (getEmail() == resource.data.email || request.auth.uid == resource.data.invitedBy);
      allow delete: if isAuthenticated() && (getEmail() == resource.data.email || request.auth.uid == resource.data.invitedBy);
    }

    match /erp_workspaces/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    function financeTenant(tenantId) {
      return get(/databases/$(database)/documents/financeTenants/$(tenantId)).data;
    }

    function isFinanceMember(tenantId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/financeTenants/$(tenantId))
        && request.auth.uid in financeTenant(tenantId).memberIds;
    }

    function financeRole(tenantId) {
      return isFinanceMember(tenantId) ? financeTenant(tenantId).members[request.auth.uid].role : 'none';
    }

    function canFinanceWrite(tenantId) {
      return financeRole(tenantId) in ['owner', 'admin', 'contributor'];
    }

    function canFinanceAdmin(tenantId) {
      return financeRole(tenantId) in ['owner', 'admin'];
    }

    match /financeMembers/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /financeTenants/{tenantId} {
      allow read: if isFinanceMember(tenantId);
      allow create: if isAuthenticated()
        && tenantId == 't_' + request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if canFinanceAdmin(tenantId)
        || (canFinanceWrite(tenantId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.members == resource.data.members);
      allow delete: if false;

      match /entities/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create, update: if canFinanceWrite(tenantId);
        allow delete: if false;
      }

      match /accounts/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create: if canFinanceWrite(tenantId);
        allow update: if canFinanceWrite(tenantId);
        allow delete: if false;

        match /movements/{movementId} {
          allow read: if isFinanceMember(tenantId);
          allow create: if canFinanceWrite(tenantId);
          allow update, delete: if false;
        }
      }

      match /taxCodes/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create, update: if canFinanceAdmin(tenantId);
        allow delete: if false;
      }

      match /periods/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create, update: if canFinanceWrite(tenantId);
        allow delete: if false;
      }

      match /parties/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create, update: if canFinanceWrite(tenantId);
        allow delete: if false;
      }

      match /journals/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create: if canFinanceWrite(tenantId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if canFinanceWrite(tenantId)
          && resource.data.status == 'posted'
          && request.resource.data.status == 'reversed'
          && request.resource.data.lines == resource.data.lines;
        allow delete: if false;
      }

      match /documents/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create: if canFinanceWrite(tenantId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if canFinanceWrite(tenantId) && (
          resource.data.status == 'draft'
          || request.resource.data.lines == resource.data.lines
        );
        allow delete: if false;
      }

      match /audit/{id} {
        allow read: if isFinanceMember(tenantId);
        allow create: if canFinanceWrite(tenantId) && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }

      match /idempotency/{id} {
        allow read, create: if canFinanceWrite(tenantId);
        allow update, delete: if false;
      }
    }
  }
}
