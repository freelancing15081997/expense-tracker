# API origin used inside the Android app (web preview uses the Vite proxy)
VITE_API_URL=https://www.easypado.com
# Cashfree checkout mode: sandbox | production (keys live on the server only)
VITE_CASHFREE_MODE=sandbox
# Firebase web config (Auth only — data lives in Neon via /api)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_SENDER_ID=
